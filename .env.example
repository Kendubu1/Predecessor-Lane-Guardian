# Copy to .env and fill in. Never commit .env.

# Required: bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Optional overrides (defaults shown)
# Where per-server settings are stored. In Docker this lives on the /data volume.
#CONFIG_PATH=/data/server_configs.json
# Port for the /health endpoint
#HEALTH_PORT=8080
# Write logs to a file in addition to stdout (leave unset to log to stdout only)
#LOG_FILE=/data/bot.log
# Log level: DEBUG, INFO, WARNING, ERROR
#LOG_LEVEL=INFO
# Seconds of silence before the bot leaves a voice channel when no timer is running
#VOICE_INACTIVITY_TIMEOUT=300
# Path or name of the Opus library if auto-detection fails
#OPUS_LIB=libopus.so.0
